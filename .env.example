# ═══════════════════════════════════════════════════════════════════
# SEU ZÉLLA — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.
# All secrets are REQUIRED in production (app will throw if missing).

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=file:./db/custom.db

# ── NextAuth (REQUIRED in production) ───────────────────────────────
NEXTAUTH_SECRET=           # Cryptographically random value (≥32 chars) — generate with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app

# ── Google OAuth (optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Encryption (REQUIRED in production) ─────────────────────────────
ENCRYPTION_SECRET=         # Cryptographically random value — generate with: openssl rand -base64 32
CACHE_SIGNING_SECRET=      # Cryptographically random value — generate with: openssl rand -base64 32

# ── ZCC Admin Panel (REQUIRED for ZCC access) ───────────────────────
ZCC_GODMODE_TOKEN=         # Cryptographically random value for admin panel access

# ── AI Providers (optional — app falls back to local/cheaper models) ─────
OLLAMA_URL=http://ollama:11434  # Em Docker VPS: http://ollama:11434 | Em Dev local: http://localhost:11434
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Meta WhatsApp Business API (REQUIRED for WhatsApp integration) ──
META_VERIFY_TOKEN=         # Your webhook verification token from Meta Developer Platform
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # Same as META_VERIFY_TOKEN (used in webhook handler)

# ── Calendar Sync (REQUIRED for iCal channel manager) ───────────────
CALENDAR_SYNC_SECRET=      # Cryptographically random value for sync endpoint auth

# ── Payment Gateways (optional during MODO MOCK) ───────────────────
# Sprint 1 unified payment architecture: Asaas (preferred) + MercadoPago + Stripe.
# At least one must be configured before exiting MODO MOCK.
# Selection priority: DEFAULT_PAYMENT_GATEWAY env > Asaas > MP > Stripe > Mock.

# Asaas — Brazilian gateway (lowest fees for sub-R$500, native recurring)
# Get token: https://sandbox.asaas.com/ (sandbox) or https://portal.asaas.com/ (prod)
ASAAS_ACCESS_TOKEN=
ASAAS_ENVIRONMENT=sandbox        # 'sandbox' | 'production'
ASAAS_WEBHOOK_SECRET=            # HMAC secret configured in Asaas webhook settings

# Mercado Pago
MP_ACCESS_TOKEN=                 # Mercado Pago access token
MP_WEBHOOK_URL=                  # Public URL for MP webhook (e.g. https://seuzella.com.br/api/webhooks/payment)

# Stripe (international fallback)
STRIPE_SECRET_KEY=               # Stripe secret key (starts with sk_)
STRIPE_WEBHOOK_SECRET=           # Stripe webhook signing secret (whsec_...)
STRIPE_ACCOUNT_ID=               # Connected account ID (acct_...) — only for Stripe Connect

# Default gateway — overrides preference order
# Valid values: 'asaas' | 'mercadopago' | 'stripe' | (unset = auto-detect)
DEFAULT_PAYMENT_GATEWAY=

# ── Public WhatsApp Numbers (Landing Page + ZCC) ──────────────────
# Replace placeholder zeros when going live. Format: country code + DDD + number.
# Example: 5548999999999 (Seu Zélla commercial line)
NEXT_PUBLIC_WHATSAPP_COMMERCIAL=5548999990000
NEXT_PUBLIC_WHATSAPP_SUPPORT=5548999990001

# ── Redis (REQUIRED in production — for rate limiting and message bundler) ──
# Without Redis, rate limiting fails CLOSED (deny-all) in production
# and message-bundler falls back to synchronous processing (blocks webhook).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── QStash (REQUIRED in production for WhatsApp message bundler) ──
# QStash defers message bundling by 3s without blocking the Vercel lambda.
# Without QStash, the webhook handler blocks for 3s per message (high latency).
# Create at: https://console.upstash.com/qstash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app   # QStash callback target

# ── Internal Endpoint Protection (REQUIRED in production) ──
# Protects /api/internal/flush-buffer from unauthorized access.
# QStash will call this endpoint after the 3s bundle delay.
INTERNAL_ENDPOINT_TOKEN=           # Cryptographically random — generate with: openssl rand -base64 32

# ── Webhook Security Bypass (DEV ONLY — never set in production) ──
# In dev, allows you to test webhook without META_APP_SECRET configured.
# MUST be unset in production — if META_APP_SECRET is missing in prod, webhook fails CLOSED.
WEBHOOK_ALLOW_NO_SECRET=false

# ── Meta Cost Tracking (production tuning) ──
# When true, records Meta cost even when WhatsApp send is in MOCK mode (no real credentials).
# Default: false (recommended — don't inflate cost stats with mock sends).
META_COST_RECORD_MOCK=false

# ── LGPD Opt-Out Keywords (configurable per tenant language) ──
# Comma-separated. Default covers PT-BR + EN.
LGPD_OPT_OUT_KEYWORDS=SAIR,STOP,PARAR,CANCELAR,DESCADASTRAR,UNSUBSCRIBE,NAOQUERO,REMOVER,OPTOUT

# ── Meta Budget Limits per Plan (USD/month) ──
# Tunable per-plan WhatsApp cost ceilings. When tenant exceeds, AI is silenced.
META_BUDGET_GRATUITO_USD=3.40
META_BUDGET_LITE_USD=12.00
META_BUDGET_PRO_USD=34.00
META_BUDGET_MAX_USD=68.00
META_BUDGET_PARCEIRO_USD=34.00

# ── Dev-only Bypass Flags (NEVER set in production) ──
# BYPASS_MIDDLEWARE_AUTH=true bypasses NextAuth in dev (uses first tenant).
# BYPASS_TENANT_LOOKUP=true makes resolveTenantByPhone return first active tenant.
BYPASS_MIDDLEWARE_AUTH=false
BYPASS_TENANT_LOOKUP=false

# ═══════════════════════════════════════════════════════════════════
# CÉREBRO ZÉLLA — Entidade Autônoma (GLM 5.2 Supervisor)
# ═══════════════════════════════════════════════════════════════════
# O Cérebro opera em MODO MOCK por padrão (apenas registra no DB + console,
# não envia alertas reais nem chama LLM). Ative live mode APENAS quando todas
# as integrações abaixo estiverem configuradas e testadas.

# ── Cérebro Mode ──────────────────────────────────────────────────
# true = ativa integrações reais (LLM, Redis Stream, email/Slack/SMS)
# false (padrão) = modo mock (apenas DB + console, sem side effects)
CEREBRO_LIVE_MODE=false

# ── LLM Provider (GLM 5.2 via Chat.z.ai) ──────────────────────────
# Já existe no projeto para atendimento de hóspedes. Reutilizado pelo Cérebro
# para análise de anomalias, previsões e sugestões de refatoração.
GLM_5_2_API_KEY=
# Alternativa legada (mesma chave):
ZHIPU_API_KEY=

# ── Alert Channels ────────────────────────────────────────────────
# Emails que recebem alertas (CSV). Usado para severity >= warning.
CEREBRO_ALERT_EMAILS=admin@seuzella.com,tech@seuzella.com

# Slack webhook URL (severity >= critical). Criar em: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# SMS via Twilio (severity = emergency apenas). Criar em: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Phone numbers para SMS emergency (CSV, formato E.164 com +)
CEREBRO_EMERGENCY_PHONES=+5511999999999

# Webhook genérico para integrações custom (severity >= critical)
# Recebe POST com JSON { subject, body, severity, scope, ... }
CEREBRO_CUSTOM_WEBHOOK_URL=

# Severity mínima para despachar alerta (info | warning | critical | emergency)
# Default: warning (info vai só para dashboard)
CEREBRO_MIN_SEVERITY=warning

# ── Cron Endpoints Protection ────────────────────────────────────
# Protege /api/cron/cerebro-watchdog (chamado por QStash a cada 1 min)
# Deve ser IGUAL a INTERNAL_ENDPOINT_TOKEN (reuso do message-bundler)
# INTERNAL_ENDPOINT_TOKEN já definido acima — não repetir aqui.

# ── QStash Schedule (para watchdog 1min) ──────────────────────────
# Criar em: https://console.upstash.com/qstash
# Schedule: POST https://smart-hotel-zehla.vercel.app/api/cron/cerebro-watchdog
# Headers: { "X-Internal-Token": "<valor de INTERNAL_ENDPOINT_TOKEN>" }
# Cron: * * * * * (todo minuto)
# NOTA: QStash Schedule é configurado via UI/CLI do Upstash, não via env var.

# ── Sentry (opcional, Passo 10 Hardening) ────────────────────────────
# Captura erros não tratados (unhandledRejection, uncaughtException) e envia
# para Sentry. Sem SDK dependency — usa HTTP direto para Sentry ingest API.
# Formato: https://<public_key>@<host>/<project_id>
# Ex: https://abc123@o12345.ingest.sentry.io/67890
# Se não configurado, erros apenas vão para LogSink (Cérebro analisa).
SENTRY_DSN=

# ── Cron Auth (CRITICAL — protege Vercel Crons) ──────────────────────
# CRON_SECRET protege /api/cron/* (budget-reset, metrics-snapshot,
# cerebro-analyze, cerebro-budget-forecast, cerebro-refactor-check, weekly-report)
# Vercel Cron envia header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── 🔐 Fechaduras Eletrônicas — Providers OAuth2 ────────────────────
# Cada provider é OPCIONAL — sem credenciais, o sistema cai no modo manual
# (host cola PIN no Zélla após gerar no app do provedor).
#
# URLs de callback OAuth (configurar no painel de cada provedor):
# TTLock:      https://seuzella.com/api/ddc/locks/oauth/ttlock/callback
# Tuya:        https://seuzella.com/api/ddc/locks/oauth/tuya/callback
# Igloohome:   https://seuzella.com/api/ddc/locks/oauth/igloohome/callback
# Nuki:        https://seuzella.com/api/ddc/locks/oauth/nuki/callback
#
# August NÃO usa OAuth popup — usa PIN de verificação SMS.
# Configure AUGUST_USERNAME/PASSWORD no painel Vercel.

# ── TTLock (open.ttlock.com) — ~30-40% market share BR ───────────
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_REDIRECT_URI=https://seuzella.com/api/ddc/locks/oauth/ttlock/callback

# ── Tuya Cloud (iot.tuya.com) — ~20-25% market share BR ──────────
# Region: us (América), eu (Europa), cn (China), in (Índia)
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_REGION=us
TUYA_REDIRECT_URI=https://seuzella.com/api/ddc/locks/oauth/tuya/callback

# ── Igloohome (api.igloohome.io) — PIN offline real ───────────────
IGLOOHOME_CLIENT_ID=
IGLOOHOME_CLIENT_SECRET=
IGLOOHOME_REDIRECT_URI=https://seuzella.com/api/ddc/locks/oauth/igloohome/callback

# ── Nuki Web API (developer.nuki.io) ──────────────────────────────
NUKI_CLIENT_ID=
NUKI_CLIENT_SECRET=
NUKI_REDIRECT_URI=https://seuzella.com/api/ddc/locks/oauth/nuki/callback

# ── August / Yale Assure 2 (api-production.august.com) ───────────
# August NÃO usa OAuth popup — usa PIN enviado por SMS/email.
# apiKey: interceptar do app August (charlesproxy ou similar)
# installId: UUID gerado por instalação (qualquer UUID v4 válido)
AUGUST_API_KEY=
AUGUST_INSTALL_ID=
AUGUST_USERNAME=
AUGUST_PASSWORD=

# ── Criptografia AES-256-GCM para tokens OAuth ───────────────────
# Já existe ENCRYPTION_SECRET no projeto — ele é reutilizado para
# criptografar access_token/refresh_token dos providers em LockOAuthAccount.
# 32 bytes em hex (64 chars) ou string de texto (será derivada via scrypt).
# Gere com: openssl rand -hex 32
# ENCRYPTION_SECRET=

# ─────────────────────────────────────────────────────────────────────
# SEMANTICA SIDECAR — GraphRAG + Decision Intelligence
# ─────────────────────────────────────────────────────────────────────
# Microserviço Python (FastAPI) que roda na VPS ao lado do Next.js.
# Em dev: docker compose -f docker-compose.semantica.yml up -d
# Em prod: systemd service (deploy/semantica-sidecar/semantica.service)

# Feature flag — ativa/desativa chamadas ao Semantica (fallback gracioso se false)
USE_SEMANTICA_GRAPH=false

# URL do sidecar Python (localhost quando co-locado com Next.js na VPS)
SEMANTICA_BASE_URL=http://127.0.0.1:7432

# API key para auth entre Next.js ↔ Python (32 chars random)
# Gere com: openssl rand -hex 16
SEMANTICA_API_KEY=

# Timeout em ms para chamadas ao sidecar (default 3000)
SEMANTICA_TIMEOUT_MS=3000

# TTL do cache LRU in-memory em segundos (default 300 = 5min)
SEMANTICA_CACHE_TTL=300

# Máximo de retries em caso de erro (default 3, com backoff exponencial)
SEMANTICA_MAX_RETRIES=3

# mTLS (produção apenas — certificados self-signed)
# Gere com: openssl req -x509 -newkey rsa:4096 -nodes -keyout server.key -out server.crt -days 365 -subj "/CN=semantica"
SEMANTICA_MTLS_ENABLED=false
SEMANTICA_MTLS_CERT_PATH=
SEMANTICA_MTLS_KEY_PATH=
SEMANTICA_MTLS_CA_PATH=

# ─────────────────────────────────────────────────────────────────────
# ZAOS YIELD ENGINE — Precificação Dinâmica (Lucro Extra Gerado pela IA)
# ─────────────────────────────────────────────────────────────────────
# Motor de Yield Management / Dynamic Pricing. Calcula tarifa reajustada
# baseada em ocupação + feriados brasileiros + dias-para-evento, e
# registra o LUCRO EXTRA gerado (yieldRate - baseRate) no banco.
#
# Estratégia comercial 2 fases:
#   Fase 1 (Temporada 2026/2027): YIELD_BONUS_SHARE_RATE=0 — gratuito
#   Fase 2 (Temporada 2027/2028): YIELD_BONUS_SHARE_RATE=0.10..0.12 — ZÉLLA BOOST

# Liga/desliga o motor (default true). Em false, retorna NOMINAL (sem surge).
YIELD_ENGINE_ENABLED=true

# % cobrada pela Zélla sobre o lucro extra (Fase 2 = ZÉLLA BOOST)
# 0 = gratuito (Fase 1)
# 0.10 = 10% performance share (recomendado)
# 0.12 = 12% premium
YIELD_BONUS_SHARE_RATE=0

# Thresholds configuráveis (defaults alinhados com estratégia do usuário)
# TIER 2 (DEMAND_SURGE): dispara quando ocupação >= 50% OU <=45 dias de feriado especial
YIELD_SURGE_OCCUPANCY=0.50
YIELD_SURGE_DAYS=45
YIELD_SURGE_MULTIPLIER=1.25

# TIER 3 (SCARCITY_LOCK): dispara quando ocupação >= 80% OU <=15 dias de feriado especial
YIELD_SCARCITY_OCCUPANCY=0.80
YIELD_SCARCITY_DAYS=15
YIELD_SCARCITY_MULTIPLIER=1.60

# Janela temporal da "temporada atual" para o Widget DDC (em dias, default 90)
YIELD_SEASON_WINDOW_DAYS=90

# ─────────────────────────────────────────────────────────────────────
# TENSORFLOW SIDECAR — 8 modelos neurais para o Cérebro Zélla
# ─────────────────────────────────────────────────────────────────────
# Python sidecar (FastAPI porta 8501) na VPS Hostinger MVK4
# Em dev: docker compose -f docker-compose.tensorflow.yml up -d
# Em prod: systemd service (deploy/tensorflow-sidecar/)

# URL do sidecar Python (localhost quando co-locado com Next.js na VPS)
TF_SIDECAR_URL=http://127.0.0.1:8501

# API key para auth entre Next.js ↔ Python (32 chars random)
# Gere com: openssl rand -hex 16
TF_API_KEY=

# Timeout em ms para chamadas ao sidecar (default 3000)
TF_TIMEOUT_MS=3000

# Feature flags — ativa modelos neurais individualmente
# false = usa heurística atual (regex, regras fixas)
# true = chama sidecar TensorFlow (fallback gracioso se offline)
USE_TF_INTENT=false
USE_TF_CHURN=false
USE_TF_LEAD=false
USE_TF_ANOMALY=false
USE_TF_OCCUPANCY=false
USE_TF_SENTIMENT=false
USE_TF_PRICE=false
USE_TF_UPSELL=false

# ═══════════════════════════════════════════════════════════════════
# ZÉCODE — DEV FULL STACK Interno (inspirado no CodeRabbit.ai)
# ═══════════════════════════════════════════════════════════════════
# Reusa o GLM 5.2 do Cérebro (mesma chave). Em modo mock (CEREBRO_LIVE_MODE=false),
# usa apenas heurísticas ($0). Em modo live, chama GLM 5.2 para análise profunda.
#
# Safety locks:
#   - Path allowlist (.ts/.tsx/.js/.jsx/.json/.prisma/.md)
#   - Dir blocklist (node_modules, .git, .next, dist, scripts)
#   - Secret redaction (20+ regex patterns, AWS/JWT/GCP/PIX/...)
#   - Budget mensal (reusa CEREBRO_MONTHLY_BUDGET_USD=$20)
#   - Rate limit (5 reviews/min, 50/hora, 10 evolves/hora)
#   - Auto-apply SEMPRE false — humano aprova
#   - GODMODE required para forceLive + autoCreatePR

# ── GitHub Integration (para auto-create PR) ──────────────────────
# Token com scope `repo` (ou `contents:write` + `pull-requests:write`)
# Criar em: https://github.com/settings/tokens (fine-grained recommended)
GITHUB_TOKEN=
# Owner do repo (ex: MarcioCau14)
GITHUB_REPO_OWNER=MarcioCau14
# Nome do repo (ex: SmartHotel_Zehla)
GITHUB_REPO_NAME=SmartHotel_Zehla

# ── GODMODE (necessário para autoCreatePR e forceLive) ───────────
# true = permite operações destrutivas (criar PR, forçar live mode)
# false (padrão) = apenas operações read-only + apply manual
ZCC_GODMODE=false

# ── GLM 5.2 (LLM embarcado do ZéCode) ─────────────────────────────
# Reusa GLM_5_2_API_KEY do Cérebro. Configurações adicionais:
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
# Temperatura baixa (0.2) para análise técnica consistente — NÃO MUDAR
GLM_REVIEWER_TEMPERATURE=0.2
GLM_REVIEWER_MAX_TOKENS=4000


# ─────────────────────────────────────────────────────────────────
# ZÉCODE × GITHUB GITOPS LAYER (Fase 1-6 — Bíblia do ZéCode)
# ─────────────────────────────────────────────────────────────────
# Doc: "Bíblia do ZéCode — GitHub GitOps"
#
# CRÍTICO: Gere estas chaves ANTES de iniciar o ZCC em produção.

# MASTER KEY para criptografia AES-256-GCM dos PATs no Vault.
# 32 bytes codificados em base64. GERAR COM: openssl rand -base64 32
# Esta key NUNCA deve ser commitada, versionada, ou exposta em logs.
# Se perdida, todos os PATs criptografados se tornam irrecuperáveis.
GITHUB_PAT_MASTER_KEY=

# URL pública do ZCC (para configuração de webhook no GitHub).
# Deve ser HTTPS válido em produção. Sem barra final.
# Ex: https://zcc.seuzella.com
ZCC_PUBLIC_URL=

# Token secreto para o GitHub Action chamar a API do ZCC.
# Deve ser o MESMO valor configurado no GitHub (secrets do repo).
# GERAR COM: openssl rand -hex 32
ZE_CODE_WEBHOOK_TOKEN=

# Secret para validar assinatura HMAC de webhooks do GitHub.
# Deve ser o MESMO valor configurado no webhook do repositório
# (Settings → Webhooks → Add webhook → Secret).
# GERAR COM: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# (Opcional) Para GitHub App:
GITHUB_APP_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./keys/ze-code-bot.private-key.pem
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_WEBHOOK_SECRET=

# (Opcional) Repositório alvo das operações do ZéCode.
# Se não definido, usa "MarcioCau14/SmartHotel_Zehla" (default).
ZECODE_TARGET_REPO=MarcioCau14/SmartHotel_Zehla

# (Opcional) Secret para cron jobs. Em produção, todos os endpoints
# de cron devem validar este header.
# GERAR COM: openssl rand -hex 32
CRON_SECRET=

# ── FIM — ZÉCODE × GITHUB GITOPS LAYER ──────────────────────────
