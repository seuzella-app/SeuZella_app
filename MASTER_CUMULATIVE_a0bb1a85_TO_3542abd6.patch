+// ════════════════════════════════════════════════════════════════════════════
+// 1. CBM BENCHMARK MENSURÁVEL
+// ════════════════════════════════════════════════════════════════════════════
+describe('📊 1. CBM Benchmark Mensurável', () => {
+  it('indexa o repositório em < 5s', () => {
+    const start = Date.now();
+    execFileSync('git', ['grep', '-l', 'export', 'src/'], {
+      timeout: 5000, encoding: 'utf8', cwd: root,
+    });
