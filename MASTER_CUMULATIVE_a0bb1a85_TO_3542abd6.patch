+
+const root = process.cwd();
+const schemaPath = path.join(root, 'prisma', 'schema.prisma');
+const matrixPath = path.join(root, 'docs', 'TENANT_ISOLATION_MATRIX.md');
+const runtimePath = path.join(root, 'src', 'lib', 'db', 'tenant-prisma.ts');
