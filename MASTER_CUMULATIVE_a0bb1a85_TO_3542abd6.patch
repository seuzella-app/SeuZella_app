+
+    it('tenant_A CANNOT count tenant_B locks', async () => {
+      vi.mocked(resolveTenantId).mockResolvedValue('tenant_A');
+      const tenantId = await resolveTenantId();
+
+      const count = await db.lockDevice.count({ where: { tenantId: tenantId! } });
