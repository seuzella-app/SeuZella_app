+  // ── Scenario 7: Retry After Failed Operation (Fail-Closed Recovery)
+  it('7. allows retry when previous operation status was failed', async () => {
+    mockDb.billingIdempotency.findUnique.mockResolvedValue({
+      id: 'idem_failed',
