+      expect(tenantRooms.length).toBeGreaterThanOrEqual(2);
+      expect(tenantRooms.every(r => r.tenantId === 'tenant_pousada_solemar')).toBe(true);
+    });
+  });
+
+  describe('Etapa 2: Hóspede + Reserva', () => {
