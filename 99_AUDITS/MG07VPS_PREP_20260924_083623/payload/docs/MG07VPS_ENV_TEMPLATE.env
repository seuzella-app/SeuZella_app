# MG07VPS_ENV_TEMPLATE — NOMES DE VARIAVEIS (SZ_MG07_VPS_PREP_V1)
# -----------------------------------------------------------------------------
# COMO USAR: copie este arquivo para /var/www/seuzella/shared/.env e preencha
# os VALORES. Os valores reais ficam no .env do iMac — copie manualmente
# (scp ou digitação), NUNCA pelo chat. Depois: chmod 600 shared/.env
#
# O deploy exige no minimo DATABASE_URL (rc=121 se ausente) e AVISA sobre
# REDIS_URL / NODE_ENV ausentes. Confira os NOMES contra o .env real do iMac —
# se o projeto usar nomes diferentes, os nomes do iMac MANDAM.
# -----------------------------------------------------------------------------

# --- OBRIGATORIAS ------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:5432/seuzella

# --- FORTEMENTE RECOMENDADAS -------------------------------------------------
# Cache/filas (o repo usa cache.ts com REDIS_URL + fallback LocalCache):
REDIS_URL=redis://127.0.0.1:6379
# URL publica do site (procura por NEXT_PUBLIC_ no .env do iMac):
NEXT_PUBLIC_APP_URL=https://SEU_DOMINIO
# Porta do next start (o kit injeta -p SZ_PORT, default 3000):
# PORT=3000

# --- GATEWAY DE PAGAMENTO (use os NOMES exatos do .env do iMac) --------------
# Exemplos de nomes comuns — NAO invente valores; copie do iMac:
# STRIPE_SECRET_KEY=<VALOR>
# STRIPE_WEBHOOK_SECRET=<VALOR>
# MERCADO_PAGO_ACCESS_TOKEN=<VALOR>
# MERCADO_PAGO_WEBHOOK_SECRET=<VALOR>
# GATEWAY_SANDBOX=true

# --- E-MAIL / NOTIFICACOES (se aplicavel) ------------------------------------
# SMTP_HOST=<VALOR>
# SMTP_PORT=<VALOR>
# SMTP_USER=<VALOR>
# SMTP_PASS=<VALOR>

# --- AUTENTICACAO / SESSOES (se aplicavel) -----------------------------------
# NEXTAUTH_SECRET=<VALOR>
# NEXTAUTH_URL=https://SEU_DOMINIO
# JWT_SECRET=<VALOR>

# --- DIRETO (migrations em banco pgbouncer, se aplicavel) --------------------
# DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/seuzella

# -----------------------------------------------------------------------------
# CHECKLIST FINAL:
#   [ ] Nenhum valor de exemplo/placeholder sobrando
#   [ ] chmod 600 no shared/.env
#   [ ] psql "$DATABASE_URL" -c 'select 1;' responde no VPS
#   [ ] Nomes conferidos 1:1 com o .env do iMac
