+      const req = new NextRequest('http://localhost/api/properties/prop_1', { method: 'DELETE' });
+      const res = await propertiesRoute.DELETE(req, { params: Promise.resolve({ id: 'prop_1' }) });
+      expect(res.status).toBe(200);
