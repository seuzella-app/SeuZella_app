  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("airb_scraping_jobs")
}

// ===== Zélla AirB — Subscriptions =====
