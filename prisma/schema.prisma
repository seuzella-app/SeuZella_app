  @@index([subscriptionId])
  @@map("airb_transactions")
}

// ===== ZCC ACCESS LOG =====
model ZCCAccessLog {
  id        String   @id @default(cuid())
  ip        String
  userAgent String?
  method    String   // godmode_param | godmode_cookie | master_key_header | nextauth_admin | failed
  success   Boolean
  country   String?  // for future geo-IP
  requestId String?
  createdAt DateTime @default(now())

  @@index([method])
  @@index([success])
  @@index([createdAt])
