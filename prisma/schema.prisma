  @@map("night_pulse_logs")
}

model NightActivityEvent {
  id              String   @id @default(cuid())
  surface         String
  eventType       String
  severity        String   @default("info")
  detailsJson     String   @default("{}")
  detectedAt      DateTime @default(now())
  windowStart     DateTime
  windowEnd       DateTime
  affectedCount   Int      @default(0)
  thresholdValue  Float    @default(0)
  observedValue   Float    @default(0)
  auditReportId   String?
  investigatedAt DateTime?
  investigatedBy  String?
  resolutionNotes String?
  @@index([surface, detectedAt])
  @@index([severity, detectedAt])
  @@index([eventType, detectedAt])
  @@map("night_activity_events")
}

model CerebroKnowledgeFact {
  id          String   @id @default(cuid())
  factType    String
  statement   String   @db.Text
  source      String
  confidence  Float    @default(0.5)
  context     String   @default("{}") @db.Text
  tags        String   @default("")
  version     Int      @default(1)
  mode        String   @default("mock")
  auditDate   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([factType, confidence])
  @@index([source])
  @@index([auditDate])
  @@index([confidence])
  @@map("cerebro_knowledge_facts")
}

model CerebroWorkflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  nodesJson   String   @db.Text
  status      String   @default("draft")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([tenantId, status])
  @@index([status, updatedAt])
  @@map("cerebro_workflows")
}

model LLMCallLog {
  id              String   @id @default(cuid())
  tenantId        String?
  model           String
  provider        String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  costUsd         Float    @default(0)
  success         Boolean  @default(true)
  errorMessage    String?  @db.Text
  feedback        String?
  promptHash      String?
  source          String   @default("unknown")
  agentId         String?
  createdAt       DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([model, createdAt])
  @@index([success, createdAt])
  @@index([source, createdAt])
  @@map("llm_call_logs")
}
