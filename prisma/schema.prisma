generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ===== ENUMS (from backup) =====
enum LeadStatus {
  PROSPECT
  QUALIFIED
  TRIAL_STARTED
  CONVERTED
  BLACKLISTED
}

enum Plan {
  LITE
  PRO
  MAX
  PARCEIRO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  posts         Post[]
  tenantId      String?
  tenant        Tenant?   @relation("UserToTenant", fields: [tenantId], references: [id])
  accounts      Account[]
  sessions      Session[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Tenant {
  id             String    @id @default(cuid())
  name           String
  email          String?   @unique
  passwordHash   String?
  phone          String?
  phoneAlt       String?
  whatsappPhoneNumber String? @unique
  whatsappBusinessId  String? @unique
  role           String    @default("owner")
  plan           String    @default("lite")
  status         String    @default("active")
  subscriptionAt DateTime?
  domain         String? @unique
  clerkOrgId     String? @unique
  property      Property?
  apiConfigs    ApiConfig[]
  agentConfigs  AgentConfig[]
  auditLogs     AuditLog[]
  calendarSyncs CalendarSync[]
  consentLogs   ConsentLog[]
  rooms        Room[]
  guests       Guest[]
  reservations Reservation[]
  transactions Transaction[]
  leads          Lead[]
  campaigns      Campaign[]
  targets        Target[]
  swipeTemplates SwipeTemplate[]
  agentLogs      AgentLog[]
  subscriptionId String?
  subscriptions  Subscription[]
  airbProperties  AirBProperty[]
  airbSubscriptions AirBSubscription[]
  bookingSyncConfigs BookingSyncConfig[]
  niche      String    @default("pousada")
  users      User[]    @relation("UserToTenant")
  isTestTenant Boolean @default(false)
  pricingRules      DynamicPricingRule[]
  pricingCalculations PricingCalculation[]
  yieldProfitRecords YieldProfitRecord[]
  mobileDevicePings DevicePing[]
  guestGuides       GuestGuide[]
  referralCodes     ReferralCode[]
  amortizationCredits AmortizationCredit[]
  liteMilestone     LiteMilestone?
  lockDevices       LockDevice[]
  lockCodes         LockCode[]
  lockEvents        LockEvent[]
  lockOAuthAccounts LockOAuthAccount[]
  upsellRecords     UpsellRecord[]
  airbExpenses      AirbExpense[]
  airbOperationTasks AirbOperationTask[]
  airbGoals         AirbGoal[]
  airbCommissions   AirbCommission[]
  airbReports       AirbReport[]
  lgpdDeleteRequests LgpdDeleteRequest[]
  lgpdIncidents      LgpdIncident[]
  pushSubscriptions  PushSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("tenants")
}

model Property {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  name            String
  document        String?
  street          String  @default("")
  number          String  @default("")
  neighborhood    String  @default("")
  city            String  @default("")
  state           String  @default("")
  zipCode         String  @default("")
  latitude        Float?
  longitude       Float?
  type            String  @default("pousada")
  website         String?
  description     String  @default("")
  services        String  @default("[]")
  paymentMethods  String  @default("[]")
  pixKey          String?
  pixKeyType      String  @default("cpf")
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  bankAccountType String?
  bankCpf         String?
  slug                    String  @unique
  linkinbioSubtitle       String  @default("")
  linkinbioAvatarUrl      String?
  linkinbioBackgroundUrl  String?
  linkinbioAccentColor    String  @default("#10b981")
  linkinbioInstagram      String?
  linkinbioRating         Float   @default(0)
  linkinbioReviewCount    Int     @default(0)
  linkinbioIsActive       Boolean @default(true)
  linkinbioPlanStart      DateTime?
  linkinbioPlanExpires    DateTime?
  linkinbioBetaEnd        DateTime?
  linkinbioIsBetaPartner  Boolean @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms  Room[]
  linkinbioLinks LinkInBioLink[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("properties")
}

model Room {
  id         String @id @default(cuid())
  propertyId String
  name       String
  type       String @default("standard")
  capacity   Int    @default(2)
  price      Float  @default(150)
  status     String @default("disponivel")
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  calendarSyncs CalendarSync[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  tenantId     String?
  reservations Reservation[]
  @@map("rooms")
}

model ApiConfig {
  id           String  @id @default(cuid())
  tenantId     String
  provider     String
  apiKey       String  @default("")
  apiSecret    String  @default("")
  model        String  @default("")
  baseUrl      String  @default("")
  isActive     Boolean @default(false)
  usageLimit   Int     @default(0)
  usageCurrent Int     @default(0)
  notes        String  @default("")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, provider])
  @@map("api_configs")
}

model AgentConfig {
  id              String  @id @default(cuid())
  tenantId        String
  agentId         String
  agentName       String
  systemPrompt    String  @default("")
  isActive        Boolean @default(true)
  temperature     Float   @default(0.7)
  maxTokens       Int     @default(2048)
  customKnowledge String  @default("[]")
  learnedPatterns Int     @default(0)
  confidenceScore Float   @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, agentId])
  @@map("agent_configs")
}

model AuditLog {
  id        String  @id @default(cuid())
  tenantId  String
  action    String
  details   String  @default("{}")
  ipAddress String?
  userAgent String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@map("audit_logs")
}

model Lead {
  id              String  @id @default(cuid())
  tenantId        String
  empresa         String
  decisor         String  @default("")
  cargo           String  @default("")
  email           String  @unique
  whatsapp        String?
  setor           String  @default("hospitalidade")
  porte           String  @default("pequeno")
  status          String  @default("pending")
  hook            String  @default("")
  socialFootprint String  @default("{}")
  targetId        String?
  name         String  @default("")
  phone        String?
  property     String?
  category     String? @default("pousada")
  city         String?
  state        String? @default("SC")
  region       String?
  googleRating Float?
  score        Int?    @default(0)
  painPoints   String?
  source       String  @default("SECRETARIA_AI")
  latitude     Float?
  longitude    Float?
  scoreValid   Int     @default(0)
  localPraia   String?
  observacoes  String?
  isCanary              Boolean   @default(false)
  estimatedValues       String?
  intentSignals         String?
  location              String?
  phoneSecondary        String?
  qualification        String?
  socialMedia           String    @default("{}")
  site                  String?
  validationScore       Float     @default(0)
  validationStatus      String    @default("pendente")
  conversionScore       Int       @default(0)
  funnelStage           String    @default("NEUTRAL")
  lastInteractionAt     DateTime?
  behavioralProfile     String?
  cluster               String    @default("COLD")
  previousCluster       String?
  lastSwipeAction       String?
  lastSwipeUsedId       String?
  tierConfidence        Float?
  tierSugerido          String?
  tierSugeridoEm        DateTime?
  roomsCount            Int       @default(0)
  instagramFollowers    Int       @default(0)
  googleReviewsCount    Int       @default(0)
  otaCommissionLost     Float     @default(0.0)
  hasWebsite            Boolean   @default(false)
  otaDependenceLevel    String    @default("MEDIUM")
  buyingBehavior        String?
  conversionProbability Float     @default(0.0)
  objectKeywords        String?
  recommendedPitch      String?
  leadTier              String    @default("COLD")
  metadata              String    @default("{}")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailTrackings EmailTracking[]
  swipeUsages    SwipeUsage[]
  funnelEvents   FunnelEvent[]
  funnelScore    FunnelScore?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
  @@map("leads")
}

model EmailTracking {
  id         String   @id @default(cuid())
  leadId     String
  campaignId String?
  openedAt   DateTime @default(now())
  ip         String?
  userAgent  String?
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
  @@index([campaignId])
  @@map("email_tracking")
}

model Target {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  domain   String
  website  String?
  city     String  @default("")
  state    String  @default("")
  status   String  @default("active")
  priority Int     @default(5)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, domain])
  @@index([tenantId])
  @@map("targets")
}

model AgentLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action    String
  status    String   @default("success")
  createdAt DateTime @default(now())
  agentId      String @default("lessie")
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  latencyMs    Int    @default(0)
  costUsd      Float  @default(0)
  errorMsg     String @default("")
  metadata     String @default("{}")
  agentName  String?
  intent     String?
  confidence Float?
  input      String?
  output     String?
  tokensUsed Int     @default(0)
  cost       Float   @default(0)
  duration   Int     @default(0)
  @@index([agentName, createdAt])
  @@index([tenantId])
  @@map("agent_logs")
}

model SecurityAlert {
  id        String   @id @default(cuid())
  severity  String   @default("medium")
  createdAt DateTime @default(now())
  type        String?
  description String    @default("")
  source      String    @default("")
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  tenantId  String?
  alertType String?
  metadata  String?
  @@index([tenantId, createdAt])
  @@index([severity, createdAt])
  @@map("security_alerts")
}

model SwipeTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @default("")
  title     String   @default("")
  content   String
  variables String   @default("[]")
  category  String   @default("prospecção")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  successRate Float @default(0)
  usageCount  Int   @default(0)
  channel            String    @default("whatsapp")
  tone               String    @default("casual")
  tier               String    @default("universal")
  painType           String?
  tags               String    @default("[]")
  timesUsed          Int       @default(0)
  conversions        Int       @default(0)
  convRate           Float     @default(0)
  lastUsedAt         DateTime?
  isAiGenerated      Boolean   @default(false)
  provenByConversion Boolean   @default(false)
  createdBy          String?
  usages SwipeUsage[]
  @@index([tenantId])
  @@map("swipe_templates")
}

model SwipeUsage {
  id             String        @id @default(cuid())
  swipeId        String
  leadId         String
  wasUsed        Boolean
  converted      Boolean?
  agentId        String?
  responseTimeMs Int?
  feedback       String?
  createdAt      DateTime      @default(now())
  swipe          SwipeTemplate @relation(fields: [swipeId], references: [id], onDelete: Cascade)
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@unique([swipeId, leadId])
  @@index([swipeId])
  @@index([leadId])
  @@index([converted])
  @@index([createdAt])
  @@map("swipe_usages")
}

model Campaign {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String   @default("whatsapp")
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetAudience  String    @default("all")
  messageTemplate String    @default("")
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalDelivered  Int       @default(0)
  totalRead       Int       @default(0)
  totalReplied    Int       @default(0)
  metadata        String    @default("{}")
  variant        String?
  totalSent      Int     @default(0)
  totalOpened    Int     @default(0)
  totalClicked   Int     @default(0)
  totalConverted Int     @default(0)
  openRate       Float   @default(0)
  clickRate      Float   @default(0)
  conversionRate Float   @default(0)
  events      FunnelEvent[]
  webhookLogs WebhookLog[]
  @@index([tenantId])
  @@map("campaigns")
}

model TrendKeyword {
  id                  String    @id @default(cuid())
  keyword             String    @unique
  category            String    @default("hotelaria")
  geo                 String?
  isActive            Boolean   @default(true)
  tier                String    @default("pro")
  checkFrequencyHours Int       @default(6)
  lastCheckedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  source String @default("google_trends")
  score  Float  @default(0)
  trend  String @default("stable")
  dataPoints TrendDataPoint[]
  @@map("trend_keywords")
}

model TrendDataPoint {
  id        String   @id @default(cuid())
  keywordId String
  date      DateTime
  source    String   @default("")
  createdAt DateTime @default(now())
  value Float @default(0)
  interestScore Int     @default(0)
  interestDelta Float?
  volume        Int?
  geo           String?
  keyword TrendKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  @@unique([keywordId, date, source])
  @@index([date])
  @@index([keywordId])
  @@map("trend_data_points")
}

model TrendSignal {
  id             String    @id @default(cuid())
  type           String
  keyword        String
  category       String
  interestScore  Int
  deltaPercent   Float
  severity       String    @default("media")
  geo            String?
  dateDetected   DateTime
  previousScore  Int?
  agentsNotified String    @default("[]")
  actionTaken    Boolean   @default(false)
  actionDetails  String?
  createdAt       DateTime  @default(now())
  resolvedAt     DateTime?
  @@index([type])
  @@index([severity])
  @@index([dateDetected])
  @@index([category])
  @@map("trend_signals")
}

model FunnelEvent {
  id          String    @id @default(cuid())
  leadId      String
  campaignId  String?
  type        String
  painCluster String?
  score       Int       @default(0)
  metadata    String?
  createdAt   DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  @@index([leadId])
  @@index([campaignId])
  @@index([type])
  @@index([painCluster])
  @@index([createdAt])
  @@map("funnel_events")
}

model FunnelScore {
  id                String    @id @default(cuid())
  leadId            String    @unique
  totalScore        Int       @default(0)
  engagementScore   Int       @default(0)
  intentScore       Int       @default(0)
  fitScore          Int       @default(0)
  cluster           String    @default("COLD")
  painCluster       String?
  lastEventAt       DateTime?
  lastClusterChange DateTime?
  previousCluster   String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([cluster])
  @@index([painCluster])
  @@index([totalScore])
  @@map("funnel_scores")
}

model WebhookLog {
  id          String    @id @default(cuid())
  campaignId  String?
  source      String
  eventType   String
  payload     String
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  retries     Int       @default(0)
  createdAt   DateTime  @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  @@index([source])
  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_logs")
}

model Guest {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  phone             String?
  email             String?
  document          String?
  status            String    @default("new")
  avatar            String?
  source            String    @default("whatsapp")
  value             Float     @default(0)
  lastContact       DateTime  @default(now())
  checkIn           DateTime?
  checkOut          DateTime?
  room              String?
  aiScore           Int       @default(50)
  notes             String?
  conversationCount Int       @default(0)
  metadata          String    @default("{}")
  bsuid          String?
  realPhone      String?
  realEmail      String?
  leadCapturedAt DateTime?
  optInAt        DateTime?
  optInMethod    String?
  optOutAt       DateTime?
  optOutMethod   String?
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  bookings      Booking[]
  messages      GuestMessage[]
  bsuidMappings BsuidMapping[]
  consentLogs   ConsentLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, bsuid])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([bsuid])
  @@index([realPhone])
  @@index([realEmail])
  @@map("guests")
}

model Reservation {
  id         String   @id @default(cuid())
  tenantId   String
  guestId    String
  roomId     String
  checkIn    DateTime
  checkOut   DateTime
  status     String   @default("CONFIRMED")
  totalPrice Float
  source     String   @default("DIRECT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])
  transactions Transaction[]
  @@index([tenantId])
  @@index([guestId])
  @@index([roomId])
  @@map("reservations")
}

model Transaction {
  id            String   @id @default(cuid())
  tenantId      String
  reservationId String?
  type          String
  amount        Float
  method        String
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  @@index([tenantId])
  @@index([reservationId])
  @@map("transactions")
}

model RouterProvider {
  id               String    @id @default(cuid())
  provider         String    @unique
  modelName        String
  tier             String    @default("3")
  alpha            Float     @default(1.0)
  beta             Float     @default(1.0)
  circuitStatus    String    @default("closed")
  lastFailureAt    DateTime?
  failureCount     Int       @default(0)
  successCount     Int       @default(0)
  avgLatencyMs     Int       @default(0)
  costPer1kInput   Float     @default(0)
  costPer1kOutput  Float     @default(0)
  isActive         Boolean   @default(true)
  supportsJson     Boolean   @default(false)
  supportsTools    Boolean   @default(false)
  maxContextTokens Int       @default(8192)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("router_providers")
}

model BudgetGuardState {
  id               String @id @default(cuid())
  date             String @unique
  dailySpendUsd    Float  @default(0)
  dailyBudgetUsd   Float  @default(50)
  monthlySpendUsd  Float  @default(0)
  monthlyBudgetUsd Float  @default(1500)
  criticalLevel    String @default("nominal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("budget_guard_state")
}

model CostLog {
  id           String   @id @default(cuid())
  tenantId     String?
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  tier         Int      @default(1)
  bucket       String   @default("general")
  cacheHit     Boolean  @default(false)
  latencyMs    Int      @default(0)
  circuitState String?
  budgetLevel  String?
  createdAt    DateTime @default(now())
  @@index([tenantId])
  @@index([createdAt])
  @@index([provider])
  @@map("cost_logs")
}

model Message {
  id         String   @id @default(cuid())
  propertyId String
  direction  String
  content    String
  createdAt  DateTime @default(now())
  @@map("messages")
}

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  planType           String
  status             String    @default("pending")
  paymentMethod      String
  amount             Float
  paymentId          String?
  paymentStatus      String?
  checkoutUrl        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  lastProrateAmount  Float?
  lastProrateDate    DateTime?
  metadata           String    @default("{}")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("subscriptions")
}

model PaymentTransaction {
  id             String  @id @default(cuid())
  subscriptionId String
  amount         Float
  status         String
  paymentMethod  String
  type           String?
  externalId     String?
  metadata       String  @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("payment_transactions")
}

model GuestMessage {
  id        String   @id @default(cuid())
  guestId   String
  from      String
  content   String
  timestamp DateTime @default(now())
  type      String   @default("text")
  sentiment String?
  intent    String?
  metadata  String   @default("{}")
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([guestId])
  @@index([timestamp])
  @@map("guest_messages")
}

model Booking {
  id             String   @id @default(cuid())
  tenantId       String
  guestId        String?
  guestName      String
  roomName       String
  roomId         String?
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  guests         Int
  totalValue     Float
  status         String   @default("pending")
  paymentMethod  String   @default("none")
  paymentStatus  String   @default("pending")
  source         String
  aiGenerated    Boolean  @default(false)
  externalUid    String?
  externalSource String?
  metadata       String   @default("{}")
  guest Guest? @relation(fields: [guestId], references: [id])
  room  Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, externalUid])
  @@index([tenantId, status])
  @@index([tenantId, checkIn])
  @@index([guestId])
  @@index([roomId])
  @@map("bookings")
}

