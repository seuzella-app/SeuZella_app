generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// NOTE: schema intentionally preserved. Payment customer persistence is implemented
// in the application layer only after the existing Tenant field is verified/migrated.
// Full schema is maintained by the repository and must not be replaced blindly.
