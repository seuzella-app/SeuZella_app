# ============================================================================
# Caddyfile — Reverse Proxy + SSL automático (Let's Encrypt)
# ============================================================================
# Substitui nginx por Caddy (mais simples, SSL automático).
# ============================================================================

{
    email admin@seuzella.com
    # staging environment para testar antes de produção
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ─── Domínio principal ────────────────────────────────────────────────────
{$DOMAIN} {
    # Redireciona www para não-www
    redir www.{$DOMAIN} https://{$DOMAIN}{uri} permanent

    # Headers de segurança
    header {
        # HSTS (HTTPS obrigatório por 1 ano)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # XSS protection
        X-XSS-Protection "1; mode=block"

        # MIME type sniffing
        X-Content-Type-Options "nosniff"

        # Clickjacking
        X-Frame-Options "DENY"

        # Referrer
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # CSP
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.cloudinary.com https://*.mercadopago.com; font-src 'self' data:; connect-src 'self' https://*.mercadopago.com wss://smart-hotel-zehla.vercel.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.mercadopago.com"

        # Remove Server header (security by obscurity)
        -Server
    }

    # Rate limiting (limite por IP)
    @ratelimited {
        path /api/*
        header X-Forwarded-For *
    }
    rate_limit @ratelimited zone=api burst=100 r=10

    # Proxy para Next.js
    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    # Compressão
    encode gzip zstd

    # Logs
    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}

# ─── Status page (BetterUptime) ─────────────────────────────────────────────
status.{$DOMAIN} {
    redir https://status.seuzella.com permanent
}

# ─── API docs (futuro) ────────────────────────────────────────────────────
docs.{$DOMAIN} {
    redir https://docs.seuzella.com permanent
}

# ─── staging (futuro) ─────────────────────────────────────────────────────
staging.{$DOMAIN} {
    reverse_proxy staging_app:3000
}
