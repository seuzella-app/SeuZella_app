# ============================================================================
# SEU ZÉLLA — .env.example (TEMPLATE DE PRODUÇÃO)
# ============================================================================
# Copie para .env.production e preencha com valores reais:
#   cp deploy/.env.example .env.production
#   nano .env.production
#
# ⚠️  NUNCA commite .env.production para o Git!
# ============================================================================

# ─── DATABASE (PostgreSQL na VPS Hostinger MVK 4) ──────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://seuzella:SUA_SENHA_FORTE@localhost:5432/seuzella_prod?schema=public"

# ─── NEXTAUTH ───────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="GERAR_32_CHARS_ALEATORIOS"
NEXTAUTH_URL="https://seuzella.com.br"

# ─── CRON AUTH ──────────────────────────────────────────────────────────────
# Token secreto para autenticar chamadas aos 17 crons via systemd
# Gerar com: openssl rand -hex 32
CRON_SECRET="GERAR_64_HEX_CHARS"

# ─── M2M EdDSA (Crons cerebro-analyze, cerebro-budget-forecast, weekly-report) ─
# Gerar par de chaves Ed25519:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   cat public.pem | tr -d '\n'  (colar abaixo)
#   cat private.pem | tr -d '\n' (colar abaixo)
ZELLA_M2M_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----MCowBQYDK2VwAyEA...-----END PUBLIC KEY-----"
ZELLA_M2M_ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----MC4CAQAwBQYDK2VwBCIEIH...-----END PRIVATE KEY-----"
ZELLA_M2M_ISSUER="https://seuzella.com.br"
ZELLA_M2M_AUDIENCE="seuzella-cron"
ZELLA_M2M_CLIENTS="cron-cerebro-analyze:secret1,cron-budget-forecast:secret2"
ZELLA_M2M_CLIENT_SCOPES="cron-cerebro-analyze:cerebro:read,cron-budget-forecast:billing:read"

# ─── WHATSAPP CLOUD API (META) ─────────────────────────────────────────────
META_APP_ID="1234567890123456"
META_APP_SECRET="SUA_META_APP_SECRET"
META_VERIFY_TOKEN="SEU_VERIFY_TOKEN_ALEATORIO"
META_PHONE_NUMBER_ID="1234567890123456"
META_BUSINESS_ID="1234567890123456"
META_ACCESS_TOKEN="EAAL...token..."
META_API_VERSION="v21.0"

# ─── MERCADO PAGO (assinaturas/pagamentos) ─────────────────────────────────
MP_ACCESS_TOKEN="APP_USR-1234567890123456-...token..."
MP_WEBHOOK_SECRET="SUA_MP_WEBHOOK_SECRET"
MP_PUBLIC_KEY="APP_USR-12345678-...key..."

# ─── ASAAS (gateway alternativo) ───────────────────────────────────────────
ASAAS_ACCESS_TOKEN=""
ASAAS_ENVIRONMENT="sandbox"  # sandbox | production
ASAAS_WEBHOOK_SECRET=""

# ─── BOOKING.COM (reviews webhook) ──────────────────────────────────────────
BOOKING_COM_WEBHOOK_SECRET="SEU_BOOKING_WEBHOOK_SECRET"
BOOKING_COM_HOTEL_ID="1234567"

# ─── AIRBNB OAUTH ───────────────────────────────────────────────────────────
AIRBNB_CLIENT_ID=""
AIRBNB_CLIENT_SECRET=""
AIRBNB_REDIRECT_URI="https://seuzella.com.br/api/oauth/airbnb/callback"

# ─── UPSTASH REDIS (rate-limit em produção) ────────────────────────────────
# Criar em: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://xxx-xxxx-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXX...token..."

# ─── CÉREBRO ZÉLLA (GLM 5.2) ───────────────────────────────────────────────
# Modo mock = false quando API estiver ativa
CEREBRO_LIVE_MODE="false"
GLM_5_2_API_KEY=""
ZHIPU_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GLM_MODEL="glm-5.2"
CEREBRO_MONTHLY_BUDGET_USD="20"
CEREBRO_DAILY_BUDGET_USD="1"
CEREBRO_ALERT_EMAILS="admin@seuzella.com.br,marcio@seuzella.com.br"
CEREBRO_EMERGENCY_PHONES="+5511999999999"
CEREBRO_MIN_SEVERITY="warning"
CEREBRO_AUTO_REMEDIATE="false"  # true em produção estável
CEREBRO_AUTO_REMEDIATE_MAX_PER_HOUR="3"
CEREBRO_AUTO_CONFIDENCE_THRESHOLD="0.85"
CEREBRO_RECURRING_ERROR_THRESHOLD="3"
CEREBRO_ALERT_DEDUP_WINDOW_MS="3600000"
CEREBRO_CUSTOM_WEBHOOK_URL=""

# ─── EMAIL (SMTP para notificações) ─────────────────────────────────────────
EMAIL_FROM="noreply@seuzella.com.br"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USER="noreply@seuzella.com.br"
SMTP_PASSWORD="SUA_SENHA_EMAIL"

# ─── ENCRYPTION (campo secrets em ApiConfig) ────────────────────────────────
# Gerar com: openssl rand -hex 32
ENCRYPTION_SECRET="GERAR_64_HEX_CHARS"
CACHE_SIGNING_SECRET="GERAR_64_HEX_CHARS"
CALENDAR_SYNC_SECRET="GERAR_64_HEX_CHARS"

# ─── AUGUST SMART LOCKS ───────────────────────────────────────────────────
AUGUST_API_KEY=""
AUGUST_INSTALL_ID=""
AUGUST_USERNAME=""
AUGUST_PASSWORD=""

# ─── LLM PROVIDERS (alternativos ao GLM) ───────────────────────────────────
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# ─── DEMO/TEST MODE ────────────────────────────────────────────────────────
# Para testes sem dados reais
DEMO_PLAN="pro"  # gratuito | lite | pro | max | parceiro
AUDIO_MOCK_MODE="true"
BATCH_API_ENABLED="true"
ENABLE_DEV_PROXY="false"
BYPASS_MIDDLEWARE_AUTH="false"
BYPASS_TENANT_LOOKUP="false"
ALLOW_PROD_RESET="false"

# ─── APP URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://seuzella.com.br"
NEXT_PUBLIC_GA_ID=""

# ─── DEFAULT PAYMENT GATEWAY ───────────────────────────────────────────────
DEFAULT_PAYMENT_GATEWAY="mercadopago"  # mercadopago | asaas

# ─── SENTRY (error tracking — recomendado) ────────────────────────────────
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── POSTHOG (product analytics — recomendado) ───────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── CLAUDE (Zellador) ─────────────────────────────────────────────────────
CLAUDE_MODEL="claude-sonnet-4-20250514"

# ─── Ajustes finais ──────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
TZ="America/Sao_Paulo"
